# Copy to .env and fill in values.

OPENAI_API_KEY=
# Model for planner + ranker (no CLI override in v1)
OPENAI_MODEL=gpt-4o

# Search: tavily | brave
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# If SEARCH_PROVIDER=brave, set instead:
# BRAVE_API_KEY=

# Optional limits (defaults used if unset)
MAX_URLS=25
MAX_PEOPLE=12
